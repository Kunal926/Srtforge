# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build artifacts
dist/
build/
*.spec.bak

# Generated runtime dirs
output/
tmp/
logs/
*.log

# Models — large binary checkpoints; only the FV4 yaml is tracked.
models/
!models/
models/*
!models/voc_gabox.yaml

# Persistent config (may contain user paths / API keys)
srtforge.config

# Secrets / env
.env
.env.*.local
.secrets/

# macOS / Windows / IDE noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Tauri Studio generated outputs
srtforge-studio/node_modules/
srtforge-studio/dist/
srtforge-studio/src-tauri/target/
srtforge-studio/src-tauri/gen/
srtforge-studio/src-tauri/output/
# Sidecar binaries are produced by PyInstaller — never check them in
srtforge-studio/src-tauri/binaries/srtforge_worker*.exe
srtforge-studio/src-tauri/binaries/srtforge_worker*
!srtforge-studio/src-tauri/binaries/srtforge_worker/
srtforge-studio/src-tauri/binaries/srtforge_worker/*
!srtforge-studio/src-tauri/binaries/srtforge_worker/.gitkeep

# Vendored ffmpeg downloaded by the installer
packaging/windows/ffmpeg/
